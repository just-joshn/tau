{
  "name": "tau-code",
  "version": "0.1.0",
  "description": "Independent TypeScript coding-agent CLI inspired by Claude Code",
  "type": "module",
  "private": true,
  "bin": {
    "tau": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && eslint src test scripts",
    "test": "npm run build && node --import ./dist/test/test-environment.js --test dist/test/*.test.js",
    "start": "node dist/src/cli.js",
    "lint": "eslint src test scripts"
  },
  "dependencies": {
    "ignore": "7.0.16",
    "marked": "18.2.1",
    "picomatch": "4.0.7",
    "string-width": "9.0.0",
    "yaml": "2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "4.0.3",
    "eslint": "^10.15.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.73.0"
  }
}
