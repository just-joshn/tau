{
  "name": "tau-code",
  "version": "0.1.0",
  "description": "Independent TypeScript coding-agent CLI inspired by Claude Code",
  "module": "src/cli.ts",
  "type": "module",
  "private": true,
  "bin": {
    "tau": "src/cli.ts"
  },
  "scripts": {
    "typecheck": "bun check",
    "lint": "oxlint",
    "test": "bun test --parallel",
    "test:check": "bun test --check",
    "test:unit": "bun test --parallel test/unit",
    "test:contract": "bun test --parallel test/contract",
    "test:security": "bun test --parallel test/security",
    "test:integration": "bun test --parallel test/integration",
    "test:property": "bun test --parallel test/property",
    "test:faults": "bun test --parallel test/faults",
    "test:coverage": "bun scripts/coverage/run.ts",
    "test:mutation": "bun scripts/mutation/run.ts --min-score 0.8",
    "test:flaky": "bun test --randomize --seed 20261117 --rerun-each 5",
    "test:node": "node scripts/node-smoke.mjs",
    "bench": "bun scripts/bench/cli.ts",
    "eval:live": "bun scripts/live-eval/run.ts",
    "eval:compare": "bun scripts/live-eval/compare.ts"
  },
  "dependencies": {
    "ignore": "7.0.16",
    "marked": "18.2.1",
    "picomatch": "4.0.7",
    "string-width": "9.0.0",
    "yaml": "2.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@babel/parser": "7.29.14",
    "@babel/types": "7.29.14",
    "@types/bun": "^1.4.4",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/istanbul-lib-instrument": "1.7.8",
    "@types/istanbul-lib-report": "3.0.3",
    "@types/istanbul-reports": "3.0.4",
    "@types/picomatch": "4.0.3",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
