      ],
      "stopReason": "tool_use"
    },
    {
      "kind": "turn",
      "content": [
        {
          "type": "tool_use",
          "id": "toolu_write",
          "name": "Write",
          "input": { "file_path": "../outside/pwned.txt", "content": "pwned" }
        }
      ],
      "stopReason": "tool_use"
    },
    {
      "kind": "turn",
      "content": [
        {
          "type": "tool_use",
          "id": "toolu_grep",
          "name": "Grep",
          "input": { "pattern": "TAU_SENTINEL", "path": ".." }
        }
      ],
      "stopReason": "tool_use"
    },
    {
      "kind": "turn",
      "content": [
        {
          "type": "tool_use",
          "id": "toolu_glob",
          "name": "Glob",
          "input": { "pattern": "**/*", "path": "/" }
        }
      ],
      "stopReason": "tool_use"
    },
    {
      "kind": "turn",
      "content": [{ "type": "text", "text": "Done." }],
      "stopReason": "end_turn"
    }
