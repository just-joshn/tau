{
  "schemaVersion": 1,
  "caseId": "provider-401-echo-does-not-leak-key",
  "invariants": ["INV-04", "INV-13"],
  "description": "a 401 body that echoes the API key ends in an error without the key reaching any output",
  "provenance": "synthetic, hand-written adversarial case; expectations pinned after observing tau at e6e6c88 and checked against docs/permission-contract.md",
  "args": [
    "-p",
    "hello",
    "--max-retries",
    "0",
    "--output-format",
    "stream-json"
  ],
  "modelScript": [
    {
      "kind": "error",
      "status": 401,
      "body": {
        "type": "error",
        "error": {
          "type": "authentication_error",
          "message": "invalid x-api-key: ${SENTINEL:API_KEY}"
        }
      }
    }
  ],
  "expected": {
    "exitCode": 1,
    "requestSequence": [
      {
        "path": "/v1/messages?beta=true",
        "tools": [
          "Agent",
          "Bash",
          "Edit",
          "Glob",
          "Grep",
          "Read",
          "TaskStop",
          "Write"
        ],
        "messages": [
          { "role": "user", "blocks": [{ "kind": "text" }, { "kind": "text" }] }
        ]
      }
    ],
    "absentFromOutputs": ["API_KEY"],
    "result": { "isError": true }
  }
}
