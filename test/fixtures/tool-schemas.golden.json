{
  "schemaVersion": 1,
  "tools": [
    {
      "name": "Read",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "file_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "offset": {
            "default": 1,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "limit": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "allow_large": {
            "type": "boolean"
          }
        },
        "required": ["file_path"],
        "additionalProperties": false
      }
    },
    {
      "name": "Write",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "file_path": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string"
          }
        },
        "required": ["file_path", "content"]
      }
    },
    {
      "name": "Edit",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "file_path": {
            "type": "string",
            "minLength": 1
          },
          "old_string": {
            "type": "string"
          },
          "new_string": {
            "type": "string"
          },
          "replace_all": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": ["file_path", "old_string", "new_string"]
      }
    },
    {
      "name": "Glob",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "path": {
            "default": ".",
            "type": "string"
          }
        },
        "required": ["pattern"],
        "additionalProperties": false
      }
    },
    {
      "name": "Grep",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "path": {
            "default": ".",
            "type": "string",
            "maxLength": 4096
          },
          "output_mode": {
            "default": "files_with_matches",
            "type": "string",
            "enum": ["content", "files_with_matches", "count"]
          },
          "-i": {
            "default": false,
            "type": "boolean"
          },
          "-n": {
            "default": true,
            "type": "boolean"
          },
          "head_limit": {
            "default": 250,
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "offset": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "required": ["pattern"],
        "additionalProperties": false
      }
    },
    {
      "name": "Bash",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "timeout": {
            "default": 30000,
            "type": "integer",
            "minimum": 1,
            "maximum": 120000
          }
        },
        "required": ["command"]
      }
    },
    {
      "name": "TaskCreate",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "subject": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "activeForm": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": ["subject", "description"],
        "additionalProperties": false
      }
    },
    {
      "name": "TaskGet",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          }
        },
        "required": ["taskId"],
        "additionalProperties": false
      }
    },
    {
      "name": "TaskUpdate",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "activeForm": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["pending", "in_progress", "completed"]
              },
              {
                "type": "string",
                "const": "deleted"
              }
            ]
          },
          "addBlocks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "addBlockedBy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metadata": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": ["taskId"],
        "additionalProperties": false
      }
    },
    {
      "name": "TaskList",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "TaskStop",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "shell_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "Agent",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "subagent_type": {
            "type": "string"
          },
          "model": {
            "type": "string",
            "enum": ["sonnet", "opus", "haiku", "fable"]
          },
          "effort": {
            "type": "string",
            "enum": ["low", "medium", "high", "xhigh", "max"]
          },
          "run_in_background": {
            "type": "boolean"
          }
        },
        "required": ["description", "prompt"],
        "additionalProperties": false
      }
    },
    {
      "name": "Skill",
      "input_schema": {
        "type": "object",
        "properties": {
          "skill": {
            "type": "string"
          },
          "args": {
            "type": "string"
          }
        },
        "required": ["skill"]
      }
    }
  ]
}
