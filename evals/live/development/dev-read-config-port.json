{
  "caseId": "dev-read-config-port",
  "version": 1,
  "priority": "P1",
  "category": "single-hop lookup",
  "intent": "What TCP port does config.json in this project configure for the server? Answer with the port number.",
  "allowedTools": ["Read", "Glob"],
  "workspace": {
    "files": {
      "config.json": "{\n  \"server\": { \"host\": \"0.0.0.0\", \"port\": 8417 },\n  \"metrics\": { \"port\": 9100 }\n}\n"
    }
  },
  "oracle": {
    "checks": [
      {
        "kind": "answer-matches",
        "pattern": "\\b8417\\b"
      }
    ]
  },
  "acceptedVariations": [
    "Mentions the metrics port 9100 as long as 8417 is identified as the server port."
  ],
  "budget": {
    "maxTurns": 6,
    "maxOutputTokensPerCall": 16000,
    "maxCostUsd": 0.75,
    "timeoutMs": 180000
  },
  "rubric": [
    "Identifies 8417 as the server port.",
    "Does not confuse the metrics port with the server port."
  ]
}
